# openGym configuration
# Copy this file to .env and adjust as needed

# Hostname passkeys are bound to (required for passkeys, optional for username/password)
RP_ID=localhost

# Full URL the app is served from (required for passkeys)
ORIGIN=http://localhost:8080

# Host port for the web UI
WEB_PORT=8080

# Name shown in the passkey prompt
RP_NAME=openGym

# User ids that get the admin dashboard (comma-separated)
# Find your user id in ./data/db.json after creating your first account
ADMIN_UIDS=

# Require an invite code to create a profile (1 = on, 0 = off)
INVITE_ONLY=0

# Session cookie lifetime in days
SESSION_DAYS=90

# VAPID subject for Web Push (auto-generated if not set)
# VAPID_SUBJECT=mailto:admin@example.com